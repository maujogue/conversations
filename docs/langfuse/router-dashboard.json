{
  "$comment": "Langfuse `Router` dashboard. Pushed by `python manage.py push_langfuse_dashboard` (see docs/langfuse/README.md). Widgets follow the /api/public/unstable/dashboard-widgets schema; `placement` is the tile on the 12-column dashboard grid.",
  "name": "Router",
  "description": "LLM router: tier share, tokens (energy proxy) and latency per tier, router overhead, cost per model, constraint fallbacks and arena votes.",
  "filters": [],
  "widgets": [
    {
      "placement": {
        "id": "tier-share-simple",
        "x": 0,
        "y": 0,
        "width": 4,
        "height": 5
      },
      "widget": {
        "name": "Router · Tier share: simple",
        "description": "Turns (root `conversation` spans) whose trace carries the `tier:simple` tag, per time bucket. Compare the three tier widgets to read the tier share.",
        "view": "observations",
        "dimensions": [],
        "metrics": [
          {
            "measure": "count",
            "agg": "count"
          }
        ],
        "filters": [
          {
            "column": "name",
            "operator": "=",
            "value": "conversation",
            "type": "string"
          },
          {
            "column": "tags",
            "operator": "any of",
            "value": [
              "tier:simple"
            ],
            "type": "arrayOptions"
          }
        ],
        "chartType": "BAR_TIME_SERIES"
      }
    },
