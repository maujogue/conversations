    {
      "placement": {
        "id": "tier-usage-simple",
        "x": 0,
        "y": 5,
        "width": 4,
        "height": 6
      },
      "widget": {
        "name": "Router · Tier simple: tokens & latency",
        "description": "Per observation name on `tier:simple` traces: count, output/total tokens (energy proxy: Langfuse does not know Wh) and p50/p95 latency in ms. The `conversation` row is end-to-end turn latency; generation rows carry the tokens.",
        "view": "observations",
        "dimensions": [
          {
            "field": "name"
          }
        ],
        "metrics": [
          {
            "measure": "count",
            "agg": "count"
          },
          {
            "measure": "outputTokens",
            "agg": "sum"
          },
          {
            "measure": "totalTokens",
            "agg": "sum"
          },
          {
            "measure": "latency",
            "agg": "p50"
          },
          {
            "measure": "latency",
            "agg": "p95"
          }
        ],
        "filters": [
          {
            "column": "tags",
            "operator": "any of",
            "value": [
              "tier:simple"
            ],
            "type": "arrayOptions"
          }
        ],
        "chartType": "PIVOT_TABLE",
        "chartConfig": {
          "row_limit": 20,
          "defaultSort": {
            "column": "sum_totalTokens",
            "order": "DESC"
          }
        }
      }
